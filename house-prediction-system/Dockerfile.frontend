FROM python:3.13-slim

WORKDIR /app

COPY requirements.frontend.txt .

RUN pip install --no-cache-dir -r requirements.frontend.txt

COPY app/ ./app/

EXPOSE 8501

CMD ["sh", "-c", "streamlit run app/streamlit_app.py --server.address=0.0.0.0 --server.port=${PORT:-8501}"]
# FROM python:3.13-slim => Creates a lightweight Python environment.
# WORKDIR /app => Sets /app as the working directory inside the container.
# COPY requirements.frontend.txt . => Copies the frontend dependencies.
# RUN pip install ... => Installs Streamlit and Requests.
# COPY app/ ./app/ => Copies your Streamlit application.
# EXPOSE 8501 => Documents that Streamlit uses port 8501.
# CMD [...] => Starts Streamlit when the container launches.